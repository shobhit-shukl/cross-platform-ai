# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=5000

# Local Postgres started via `docker compose up -d` at the repo root.
DATABASE_URL="postgresql://crosspost:crosspost@localhost:5432/crosspost_ai?schema=public"

FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:5000"

# App-session JWT. Generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Signs the OAuth `state` param. Must differ from JWT_SECRET. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=""

# AES-256-GCM key used to encrypt access/refresh tokens at rest. Must be exactly 64 hex
# characters (32 bytes). Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID.
# See README.md for the full setup walkthrough.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/auth/youtube/callback"

# Same OAuth client as above, registered with a second redirect URI for Drive.
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:5000/auth/google-drive/callback"

# Same OAuth client, registered with a third redirect URI for Calendar.
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:5000/auth/google-calendar/callback"

# LinkedIn is a separate OAuth vendor, not Google — its own Developer app at
# linkedin.com/developers/apps. Optional: the API boots without these.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:5000/auth/linkedin/callback"

# Google Gemini (Generative Language API) — https://aistudio.google.com/apikey
# Separate from the OAuth credentials above and not interchangeable with them.
# Optional: the API boots without it, AI features are just unavailable.
GEMINI_API_KEY=""
